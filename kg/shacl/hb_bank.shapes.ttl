@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix hb:    <https://example.org/honda-bank/kg#> .

hb:ContractShape
  a sh:NodeShape ;
  sh:targetClass hb:Contract ;
  sh:property [ sh:path hb:contractKey ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
  sh:property [ sh:path hb:hasCustomer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hb:Customer ] ;
  sh:property [ sh:path hb:hasDealer ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hb:Dealer ] ;
  sh:property [ sh:path hb:hasVehicle ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hb:Vehicle ] ;
  sh:property [ sh:path hb:inCountry ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hb:Country ] .

hb:PaymentShape
  a sh:NodeShape ;
  sh:targetClass hb:Payment ;
  sh:property [ sh:path hb:paymentForContract ; sh:minCount 1 ; sh:maxCount 1 ; sh:class hb:Contract ] ;
  sh:property [ sh:path hb:paymentDate ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:date ] ;
  sh:property [ sh:path hb:amountPaid ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ] ;
  sh:property [ sh:path hb:daysPastDue ; sh:maxCount 1 ; sh:datatype xsd:integer ] .

