@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix hb: <https://example.org/honda-bank/kg#> .

hb:ContractShape a sh:NodeShape ;
  sh:targetClass hb:Contract ;
  sh:property [
    sh:path hb:hasCustomer ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path hb:hasDealer ;
    sh:minCount 0 ;
  ] .

hb:DefaultEventShape a sh:NodeShape ;
  sh:targetClass hb:DefaultEvent ;
  sh:property [
    sh:path hb:forContract ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path hb:eventDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
  ] .

hb:PaymentShape a sh:NodeShape ;
  sh:targetClass hb:Payment ;
  sh:property [
    sh:path hb:paymentForContract ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path hb:paymentDate ;
    sh:datatype xsd:date ;
    sh:minCount 1 ;
  ] ;
  sh:property [
    sh:path hb:dpdAtPayment ;
    sh:datatype xsd:integer ;
  ] .
