@prefix hb:   <https://example.org/honda-bank/kg#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .

hb: a owl:Ontology ;
  rdfs:label "Honda Bank (demo) Knowledge Graph Ontology"@en ;
  rdfs:comment "Demo ontology for banking KG (Customer/Contract/Default/Payment) with provenance."@en ;
  owl:versionInfo "0.3.0"@en .

# Core classes
hb:Customer a owl:Class .
hb:Dealer a owl:Class .
hb:Country a owl:Class .
hb:Vehicle a owl:Class .
hb:Contract a owl:Class .
hb:DefaultEvent a owl:Class .
hb:Payment a owl:Class .

# Object properties
hb:hasCustomer a owl:ObjectProperty ; rdfs:domain hb:Contract ; rdfs:range hb:Customer .
hb:hasDealer   a owl:ObjectProperty ; rdfs:domain hb:Contract ; rdfs:range hb:Dealer .
hb:hasVehicle  a owl:ObjectProperty ; rdfs:domain hb:Contract ; rdfs:range hb:Vehicle .
hb:inCountry   a owl:ObjectProperty ; rdfs:domain hb:Contract ; rdfs:range hb:Country .
hb:forContract a owl:ObjectProperty ; rdfs:domain hb:DefaultEvent ; rdfs:range hb:Contract .

hb:paymentForContract a owl:ObjectProperty ; rdfs:domain hb:Payment ; rdfs:range hb:Contract .

# Contract/default datatype properties
hb:approvedAmount a owl:DatatypeProperty ; rdfs:domain hb:Contract ; rdfs:range xsd:decimal .
hb:termMonths     a owl:DatatypeProperty ; rdfs:domain hb:Contract ; rdfs:range xsd:integer .
hb:interestRate   a owl:DatatypeProperty ; rdfs:domain hb:Contract ; rdfs:range xsd:decimal .
hb:eventDate      a owl:DatatypeProperty ; rdfs:domain hb:DefaultEvent ; rdfs:range xsd:date .
hb:defaultAmount  a owl:DatatypeProperty ; rdfs:domain hb:DefaultEvent ; rdfs:range xsd:decimal .
hb:recoveryAmount a owl:DatatypeProperty ; rdfs:domain hb:DefaultEvent ; rdfs:range xsd:decimal .

# Country/vehicle/customer properties
hb:fuelType     a owl:DatatypeProperty ; rdfs:domain hb:Vehicle ; rdfs:range xsd:string .
hb:vehicleModel a owl:DatatypeProperty ; rdfs:domain hb:Vehicle ; rdfs:range xsd:string .
hb:countryCode  a owl:DatatypeProperty ; rdfs:domain hb:Country ; rdfs:range xsd:string .
hb:countryName  a owl:DatatypeProperty ; rdfs:domain hb:Country ; rdfs:range xsd:string .
hb:segment      a owl:DatatypeProperty ; rdfs:domain hb:Customer ; rdfs:range xsd:string .

# Payment properties
hb:paymentKey a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:string .
hb:paymentDate a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:date .
hb:scheduledAmount a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:decimal .
hb:paidAmount a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:decimal .
hb:principalComponent a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:decimal .
hb:interestComponent a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:decimal .
hb:feeComponent a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:decimal .
hb:dpdAtPayment a owl:DatatypeProperty ; rdfs:domain hb:Payment ; rdfs:range xsd:integer .

# Keys
hb:customerKey a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain hb:Customer ; rdfs:range xsd:string .
hb:dealerKey   a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain hb:Dealer   ; rdfs:range xsd:string .
hb:contractKey a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain hb:Contract ; rdfs:range xsd:string .
hb:countryKey  a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain hb:Country  ; rdfs:range xsd:string .
hb:vehicleKey  a owl:DatatypeProperty, owl:FunctionalProperty ; rdfs:domain hb:Vehicle  ; rdfs:range xsd:string .

# Provenance (dataset-level)
hb:DatasetRun a owl:Class .
hb:gitCommit a owl:DatatypeProperty ; rdfs:domain hb:DatasetRun ; rdfs:range xsd:string .
hb:sourceModel a owl:DatatypeProperty ; rdfs:domain hb:DatasetRun ; rdfs:range xsd:string .
