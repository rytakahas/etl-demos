@prefix : <https://example.org/honda-bank/kg#> .
@prefix hb: <https://example.org/honda-bank/kg#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

hb: a owl:Ontology ;
  rdfs:label "Honda Bank (demo) Knowledge Graph Ontology"@en ;
  rdfs:comment "Tiny ontology to layer a semantic KG on top of an ETL/DWH. Adapt to your etl-demos marts."@en ;
  owl:versionInfo "0.2.0"@en .

### -----------------------
### Core classes
### -----------------------

hb:Customer a owl:Class ;
  rdfs:label "Customer"@en ;
  rdfs:comment "A customer (borrower) of the bank."@en ;
  skos:definition "A party that enters into a financing contract with the bank."@en .

hb:Dealer a owl:Class ;
  rdfs:label "Dealer"@en ;
  rdfs:comment "A dealer (originator or partner) associated with vehicle financing."@en .

hb:Country a owl:Class ;
  rdfs:label "Country"@en ;
  rdfs:comment "A country used for geographic segmentation/reporting."@en .

hb:Vehicle a owl:Class ;
  rdfs:label "Vehicle"@en ;
  rdfs:comment "A financed vehicle associated with a contract."@en .

hb:Contract a owl:Class ;
  rdfs:label "Contract"@en ;
  rdfs:comment "A financing contract between the bank and a customer."@en .

hb:DefaultEvent a owl:Class ;
  rdfs:label "Default event"@en ;
  rdfs:comment "An event indicating that a contract entered default."@en .

### -----------------------
### Object properties
### -----------------------

hb:hasCustomer a owl:ObjectProperty ;
  rdfs:label "has customer"@en ;
  rdfs:comment "Links a contract to its customer."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range hb:Customer .

hb:hasDealer a owl:ObjectProperty ;
  rdfs:label "has dealer"@en ;
  rdfs:comment "Links a contract to the dealer involved in origination."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range hb:Dealer .

hb:inCountry a owl:ObjectProperty ;
  rdfs:label "in country"@en ;
  rdfs:comment "Links a contract to the country for reporting/segmentation."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range hb:Country .

hb:hasVehicle a owl:ObjectProperty ;
  rdfs:label "has vehicle"@en ;
  rdfs:comment "Links a contract to the financed vehicle."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range hb:Vehicle .

hb:forContract a owl:ObjectProperty ;
  rdfs:label "for contract"@en ;
  rdfs:comment "Links a default event to the contract it refers to."@en ;
  rdfs:domain hb:DefaultEvent ;
  rdfs:range hb:Contract .

### -----------------------
### Datatype properties
### -----------------------

hb:approvedAmount a owl:DatatypeProperty ;
  rdfs:label "approved amount"@en ;
  rdfs:comment "Approved principal amount for the contract."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range xsd:decimal .

hb:termMonths a owl:DatatypeProperty ;
  rdfs:label "term (months)"@en ;
  rdfs:comment "Contract term in months."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range xsd:integer .

hb:interestRate a owl:DatatypeProperty ;
  rdfs:label "interest rate"@en ;
  rdfs:comment "Nominal interest rate for the contract."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range xsd:decimal .

hb:fundingRate a owl:DatatypeProperty ;
  rdfs:label "funding rate"@en ;
  rdfs:comment "Internal funding rate used for margin calculations."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range xsd:decimal .

hb:originationDate a owl:DatatypeProperty ;
  rdfs:label "origination date"@en ;
  rdfs:comment "Date the contract was originated."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range xsd:date .

hb:fuelType a owl:DatatypeProperty ;
  rdfs:label "fuel type"@en ;
  rdfs:comment "Fuel type of the vehicle (e.g., petrol, diesel, EV)."@en ;
  rdfs:domain hb:Vehicle ;
  rdfs:range xsd:string .

hb:vehicleModel a owl:DatatypeProperty ;
  rdfs:label "vehicle model"@en ;
  rdfs:comment "Model descriptor for the vehicle."@en ;
  rdfs:domain hb:Vehicle ;
  rdfs:range xsd:string .

hb:defaultAmount a owl:DatatypeProperty ;
  rdfs:label "default amount"@en ;
  rdfs:comment "Amount in default at the time of the event."@en ;
  rdfs:domain hb:DefaultEvent ;
  rdfs:range xsd:decimal .

hb:recoveryAmount a owl:DatatypeProperty ;
  rdfs:label "recovery amount"@en ;
  rdfs:comment "Recovered amount associated with the default event."@en ;
  rdfs:domain hb:DefaultEvent ;
  rdfs:range xsd:decimal .

hb:eventDate a owl:DatatypeProperty ;
  rdfs:label "event date"@en ;
  rdfs:comment "Date of the default event."@en ;
  rdfs:domain hb:DefaultEvent ;
  rdfs:range xsd:date .

### -----------------------
### Key properties (used for joining / identity)
### -----------------------

hb:customerKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "customer key"@en ;
  rdfs:comment "Stable business key for Customer (string)."@en ;
  rdfs:domain hb:Customer ;
  rdfs:range xsd:string .

hb:dealerKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "dealer key"@en ;
  rdfs:comment "Stable business key for Dealer (string)."@en ;
  rdfs:domain hb:Dealer ;
  rdfs:range xsd:string .

hb:contractKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "contract key"@en ;
  rdfs:comment "Stable business key for Contract (string)."@en ;
  rdfs:domain hb:Contract ;
  rdfs:range xsd:string .

hb:countryKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "country key"@en ;
  rdfs:comment "Stable business key for Country (string)."@en ;
  rdfs:domain hb:Country ;
  rdfs:range xsd:string .

hb:vehicleKey a owl:DatatypeProperty, owl:FunctionalProperty ;
  rdfs:label "vehicle key"@en ;
  rdfs:comment "Stable business key for Vehicle (string)."@en ;
  rdfs:domain hb:Vehicle ;
  rdfs:range xsd:string .
