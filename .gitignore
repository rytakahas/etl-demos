# OS cruft
.DS_Store

# Python bytecode / cache
__pycache__/
*.py[cod]
*.pyo

# Virtualenvs
.venv/
.env*/
venv/

# Local env & secrets
.env
dev.env
include/gcp-dbt-sa.json

# Airflow logs (if you add a logs dir later)
logs/
airflow_logs/

# data
data/*.csv

# dbt artifacts
dbt/target/
dbt/logs/
dbt/manifest.json
dbt/run_results.json
dbt/graph.gpickle
dbt/graph_summary.json
dbt/partial_parse.msgpack
dbt/semantic_manifest.json

# Pytest / coverage (if you add them later)
.pytest_cache/
.coverage
htmlcov/

# Astro / Docker intermediate stuff (if present)
.astro/

cat >> .gitignore <<'EOF'

# --- Neo4j local runtime (DO NOT COMMIT) ---
kg/neo4j/data/
kg/neo4j/logs/
kg/neo4j/plugins/
kg/neo4j/exports/
kg/neo4j/import/*.dump
*.dump

# --- n8n local data ---
**/.n8n/
kg/ai_agents/**/data/
kg/ai_agents/**/exports/

# --- local env / secrets ---
.env
.env.*
claude_desktop_config.json
EOF

